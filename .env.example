# Database. This default matches `pnpm db:local`, the embedded database that
# needs no install and no account. Replace it with any Postgres URL for
# production.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Sign-in sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Encrypts the API keys you save in the app. Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# Where the app is served from
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Optional. Needed only for the AI steps (Generate Text, Generate Image) and
# for generating workflows from a prompt.
AI_GATEWAY_API_KEY=
